    let result = malloc(32) as ResStr
    if result == 0 {
        return 0 as ResStr
    }
    result.ok = 0
    result.item = ""
    result.error_code = code
    result.error = message
    return result
}

function bool res_str_is_ok(ResStr result) {
    if result == 0 {
        return false
    }
    return result.ok != 0
}

function bool res_str_is_err(ResStr result) {
    if result == 0 {
        return true
    }
