enum State {
    Idle,
    Running,
    Dead,
}

function int score(State state) {
    switch state {
    case State.Idle:
        return 1
    case State.Running:
        return 2
    else:
        return 3
    }
}

function int main() {
    if score(State.Idle) != 1 {
        return 1
    }
    return 0
}
