// same as benchmark_general but with i64 instead of int (i32)
function i64 fold(i64 x, i64 bias) {
    var y = x * 17 + bias
    if y < bias {
        y = y + 31
    } else {
        y = y - 17
    }
    if y < 1000 {
        y = y + 7
    } else {
        y = y - 5
    }
    return y
}

function i64 blend(i64 left, i64 right) {
    var v = left + right * 3
    if left < right {
        v = v + left
    } else {
        v = v - right
    }
    return v
}

function i64 main() {
    var total: i64 = 0
    var state: i64 = 7
    var noise: i64 = 11
    var i: i64 = 0

    while i < 6000000 {
        let a = fold(state, noise)
        let b = blend(a, noise)

        if b < state {
            total = total + a
            noise = noise + 5
        } else {
            total = total + b
            noise = noise - 3
        }

        if i < noise {
            total = total + state
            state = state + 2
        } else {
            total = total - noise
            state = state + 1
        }

        i = i + 1
    }

    return total
}
