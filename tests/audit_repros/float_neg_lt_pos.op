// repro: -1.0 < 1.0 — float says TRUE
// as int bits: 0xBFF... is large negative; 0x3FF... is positive small. Signed cmp: TRUE.
// hmm same.
// try: -0.0 < 0.0 — float says FALSE (-0.0 == 0.0 in float); but -0.0 = 0x80000000, 0.0 = 0x00000000. as signed, -0.0 < 0.0 (since neg < pos)
function int main() {
    var a: f64 = -0.0
    var b: f64 = 0.0
    if a < b {
        return 1
    }
    return 0
}
