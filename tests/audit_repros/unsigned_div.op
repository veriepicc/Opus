// repro: u64 division should use div, not idiv. dividend with high bit set
function int main() {
    var a: u64 = 0x8000000000000000 as u64
    var b: u64 = 2 as u64
    var q: u64 = a / b
    // expected: 0x4000000000000000 = 4611686018427387904
    // signed idiv would treat a as negative, give 0xC000000000000000
    if q == 4611686018427387904 {
        return 0
    }
    return 1
}
