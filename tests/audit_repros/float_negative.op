// repro: -1.0 as f64 has high sign bit set in bits.
// if compared as i64, -1.0 (0xBFF0000000000000) > 1.0 (0x3FF0000000000000) is FALSE since -1.0 has the sign bit set so as signed int it's negative. -1.0 < 1.0 should be TRUE both as float and as signed int.
// but -1.0 < -2.0 (more negative) — float says false; as signed int, 0xBFF... vs 0xC000... 0xC000 > 0xBFF, but as signed both negative, more negative magnitude.
function int main() {
    var a: f64 = -1.0
    var b: f64 = -2.0
    if a < b {
        return 1
    }
    return 0
}
