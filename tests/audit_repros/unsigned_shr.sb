// repro: u64 >> should be logical (shr), not arithmetic (sar)
function int main() {
    var a: u64 = 0x8000000000000000 as u64
    var b: u64 = a >> 1
    // logical shr -> 0x4000000000000000
    // arithmetic sar -> 0xC000000000000000
    if b == 4611686018427387904 {
        return 0
    }
    return 1
}
