// repro: float compare may be int-truncate-compare
// 1.9 truncates to 1, 1.1 truncates to 1, so equal as int
// but as floats, 1.9 > 1.1
function int main() {
    var a: f64 = 1.9
    var b: f64 = 1.1
    if a > b {
        return 0
    }
    // if returns 1, opus is comparing truncated ints
    return 1
}
