class FloatProbe {
    int base

    function int check(f32 x, f32 y) {
        if self.base != 7 {
            return 10
        }
        if x != 1.5f {
            return 11
        }
        if y != 2.5f {
            return 12
        }
        return 77
    }

    function f32 bounce(f32 x) {
        return x
    }
}

function int main() {
    let probe = FloatProbe { base: 7 }
    if probe.bounce(3.5f) != 3.5f {
        return 20
    }
    return probe.check(1.5f, 2.5f)
}
