struct Data {
    value: i64
    buffer: ptr
}

function int main() {
    let buf = malloc(32)
    let d = malloc(16)
    mem_write(d, 0)
    mem_write(d + 8, buf)

    let h = spawn worker(d)
    await h

    print_int(mem_read(d))
    free(d)
    free(buf)
    return 0
}

function int worker(ptr d) {
    let old = mem_read(d + 8)
    sleep(1)
    mem_write(d, 12345)
    return 0
}