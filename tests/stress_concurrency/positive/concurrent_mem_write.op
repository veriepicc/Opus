function int main() {
    let ptr = malloc(16)
    mem_write(ptr, 0)
    mem_write(ptr + 8, 0)

    let h1 = spawn writer(ptr, 111, 222)
    let h2 = spawn writer(ptr, 333, 444)
    await h1
    await h2

    print_int(mem_read(ptr))
    print_int(mem_read(ptr + 8))
    free(ptr)
    return 0
}

function int writer(ptr p, int x, int y) {
    mem_write(p, x)
    sleep(1)
    mem_write(p + 8, y)
    return 0
}