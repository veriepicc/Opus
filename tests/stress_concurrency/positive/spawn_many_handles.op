function int main() {
    let h1 = spawn worker(1)
    let h2 = spawn worker(2)
    let h3 = spawn worker(3)
    let h4 = spawn worker(4)
    let r1 = await h1
    let r2 = await h2
    let r3 = await h3
    let r4 = await h4
    print_int(r1)
    print_int(r2)
    print_int(r3)
    print_int(r4)
    return 0
}

function int worker(int id) {
    sleep(id * 10)
    return id * 100
}