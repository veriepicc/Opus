function int worker(int x) {
    return x * 2
}

function int main() {
    let h1 = spawn worker(1)
    let h2 = spawn worker(2)
    let r1 = await h1
    let r2 = await h1
    let r3 = await h2
    if r1 != 2 || r2 != 0 || r3 != 4 || h1 != 0 || h2 != 0 {
        return 1
    }
    print_int(r1)
    print_int(r2)
    print("handle reuse ok\n")
    return 0
}
