function int main() {
    let h = spawn sleeper(1)
    let first = await h
    if h != 0 || first != 1 {
        return 1
    }
    let second = await h
    if second != 0 {
        return 2
    }
    print("consumed handle await ok\n")
    return 0
}

function int sleeper(int ms) {
    sleep(ms)
    return ms
}
