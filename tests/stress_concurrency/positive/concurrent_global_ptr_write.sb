var shared_ptr: ptr = 0

function int worker(int id) {
    let val = id * 100
    shared_ptr = val as ptr
    sleep(1)
    return shared_ptr as int
}

function int main() {
    let h1 = spawn worker(1)
    let h2 = spawn worker(2)
    let r1 = await h1
    let r2 = await h2
    print_int(r1)
    print_int(r2)
    return 0
}