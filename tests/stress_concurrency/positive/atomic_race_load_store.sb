function int worker(ptr addr) {
    let val = atomic_load(addr)
    sleep(1)
    atomic_store(addr, val + 1)
    return 0
}

function int main() {
    let counter = malloc(8)
    mem_write(counter, 0)
    let h1 = spawn worker(counter)
    let h2 = spawn worker(counter)
    await h1
    await h2
    print_int(mem_read(counter))
    free(counter)
    return 0
}