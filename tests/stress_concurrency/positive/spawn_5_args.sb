function int main() {
    let h1 = spawn sleep_worker(5)
    let h2 = spawn sleep_worker(5)
    let h3 = spawn sleep_worker(5)
    let h4 = spawn sleep_worker(5)
    let r1 = await h1
    let r2 = await h2
    let r3 = await h3
    let r4 = await h4
    print_int(r1)
    print_int(r2)
    print_int(r3)
    print_int(r4)
    return 0
}

function int sleep_worker(int ms) {
    sleep(ms)
    return ms * 2
}