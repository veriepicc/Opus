var shared: i64 = 0

function int main() {
    let h1 = spawn increment()
    let h2 = spawn increment()
    let h3 = spawn increment()
    let h4 = spawn increment()
    await h1
    await h2
    await h3
    await h4
    print_int(shared)
    return 0
}

function int increment() {
    let temp = shared
    sleep(1)
    shared = temp + 1
    return shared as int
}