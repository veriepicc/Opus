var shared_counter: i64 = 0

function int increment(int n) {
    var i = 0
    while i < n {
        shared_counter = shared_counter + 1
        i = i + 1
    }
    return shared_counter as int
}

function int main() {
    let h1 = spawn increment(10000)
    let h2 = spawn increment(10000)
    let r1 = await h1
    let r2 = await h2
    print_int(shared_counter)
    return 0
}