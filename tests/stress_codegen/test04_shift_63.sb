// TEST 4: shift by 63 bits (edge case)

function int shift_63_left() {
    return 1 << 63
}

function int shift_63_right(int x) {
    return x >> 63
}

function int main() {
    // this should produce extreme values
    let a = shift_63_left()
    let b = shift_63_right(-2147483648)
    print_int(a)
    print(" ")
    print_int(b)
    print("\n")
    return 0
}