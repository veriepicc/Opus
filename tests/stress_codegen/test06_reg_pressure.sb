// TEST 6: register pressure - use more than 16 variables
// x64 has 16 general purpose registers, exceeding this stresses the allocator

function int register_pressure() {
    let a0 = 1
    let a1 = 2
    let a2 = 3
    let a3 = 4
    let a4 = 5
    let a5 = 6
    let a6 = 7
    let a7 = 8
    let a8 = 9
    let a9 = 10
    let a10 = 11
    let a11 = 12
    let a12 = 13
    let a13 = 14
    let a14 = 15
    let a15 = 16
    let a16 = 17
    let a17 = 18
    let a18 = 19
    let a19 = 20
    let result = a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19
    return result
}

function int main() {
    print_int(register_pressure())
    print("\n")
    return 0
}