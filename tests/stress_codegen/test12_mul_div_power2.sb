// TEST 12: multiply by power of 2 (might constant fold incorrectly)

function int mul_power_of_two(int x) {
    return x * 8  // should be x << 3
}

function int div_power_of_two(int x) {
    return x / 8  // should be x >> 3 for positive
}

function int main() {
    let a = mul_power_of_two(123)
    let b = div_power_of_two(1000)
    print_int(a)
    print(" ")
    print_int(b)
    print("\n")
    return 0
}