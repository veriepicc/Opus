// TEST 11: dead code elimination test
// compiler should not remove code with side effects

var global_counter: int = 0

function int side_effect() {
    global_counter = global_counter + 1
    return global_counter
}

function int main() {
    let a = side_effect()
    // test: if(false) body should be eliminated but compiler must not crash
    if false {
        let b = side_effect()
        print_int(b)
    }
    // actually just return what we got
    print_int(a)
    print("\n")
    return 0
}