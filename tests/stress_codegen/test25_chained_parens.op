// TEST: chained if-else equivalent of ternary
function int chained_parens(int a, int b, int c, int d) {
    if a < b && b <= c {
        if c < d {
            return 1
        }
        return 2
    }
    return 3
}

function int main() {
    let a = chained_parens(1, 2, 3, 4)
    let b = chained_parens(1, 1, 2, 3)
    let c = chained_parens(3, 2, 1, 0)
    print_int(a); print(" ")
    print_int(b); print(" ")
    print_int(c); print("\n")
    return 0
}