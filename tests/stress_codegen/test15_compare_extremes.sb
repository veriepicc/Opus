// TEST 15: comparison with extreme values

function int compare_extremes() {
    var result = 0

    if -2147483648 < 0 { result = result + 1 }
    if -2147483648 < -1 { result = result + 1 }
    if 2147483647 > 0 { result = result + 1 }
    if 2147483647 > 2147483646 { result = result + 1 }

    if -2147483648 == -2147483648 { result = result + 1 }
    if 2147483647 == 2147483647 { result = result + 1 }

    if -2147483648 >= -2147483648 { result = result + 1 }

    return result
}

function int main() {
    print_int(compare_extremes())
    print("\n")
    return 0
}