// TEST 10: loop with overflow check

function int loop_overflow() {
    var i = 0
    var count = 0
    while i < 1000 {
        if i == 2147483647 {
            return -1
        }
        count = count + 1
        i = i + 1
    }
    return count
}

function int main() {
    let result = loop_overflow()
    print_int(result)
    print("\n")
    return 0
}