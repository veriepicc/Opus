// TEST: loop unrolling edge cases
function int loop_unroll() {
    var sum = 0
    // simple loop - compiler might try to unroll
    var i = 0
    while i < 16 {
        sum = sum + i
        i = i + 1
    }
    return sum
}

function int main() {
    print_int(loop_unroll())
    print("\n")
    return 0
}