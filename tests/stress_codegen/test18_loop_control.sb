// TEST 18: while loop with break and continue

function int loop_with_control() {
    var i = 0
    var sum = 0
    while i < 20 {
        i = i + 1
        if i == 5 {
            continue  // skip 5
        }
        if i == 15 {
            break  // stop at 15
        }
        sum = sum + i
    }
    return sum
}

function int main() {
    print_int(loop_with_control())
    print("\n")
    return 0
}