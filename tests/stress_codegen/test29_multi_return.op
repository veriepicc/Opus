// TEST: multiple returns in function
function int multi_return(int x) {
    if x < 0 {
        return -1
    }
    if x == 0 {
        return 0
    }
    if x > 100 {
        return 100
    }
    return x
}

function int main() {
    let a = multi_return(-5)
    let b = multi_return(0)
    let c = multi_return(50)
    let d = multi_return(500)
    print_int(a); print(" ")
    print_int(b); print(" ")
    print_int(c); print(" ")
    print_int(d); print("\n")
    return 0
}