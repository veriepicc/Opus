// TEST 17: if-else with side effects

var counter: int = 0

function int get_count() {
    counter = counter + 1
    return counter
}

function int main() {
    let a = get_count()
    if a > 0 {
        let b = get_count()
        print_int(b)
    }
    if a == 0 {
        let c = get_count()
        print_int(c)
    }
    print("\n")
    return 0
}