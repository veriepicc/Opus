// TEST 3: shift by >= 64 bits

function int shift_left_64(int x) {
    return x << 64
}

function int shift_right_64(int x) {
    return x >> 64
}

function int main() {
    // shift by >= 64 is undefined behavior in C but compiler must handle
    let a = shift_left_64(1)
    let b = shift_right_64(100)
    print_int(a)
    print(" ")
    print_int(b)
    print("\n")
    return 0
}