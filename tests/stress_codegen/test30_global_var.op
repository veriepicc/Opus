// TEST: global variable access
var global_a: int = 100
var global_b: int = 200

function int access_globals() {
    global_a = global_a + 1
    global_b = global_b - 1
    return global_a + global_b
}

function int main() {
    let a = access_globals()
    let b = access_globals()
    print_int(a); print(" ")
    print_int(b); print("\n")
    return 0
}