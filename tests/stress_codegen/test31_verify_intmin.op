// VERIFY: test that INT_MIN / -1 is handled correctly
// In x86/x64, idiv of INT_MIN / -1 should trigger #DE (divide error)
// But in practice, most compilers handle this gracefully

function int verify_intmin_div(int divisor) {
    return -2147483648 / divisor
}

function int main() {
    // Test various divisors
    let a = verify_intmin_div(1)    // -2147483648 / 1 = -2147483648
    let b = verify_intmin_div(-1)   // overflow, but behavior is implementation-defined
    let c = verify_intmin_div(2)    // -1073741824
    let d = verify_intmin_div(3)    // -715827882
    print_int(a); print(" ")
    print_int(b); print(" ")
    print_int(c); print(" ")
    print_int(d); print("\n")
    return 0
}