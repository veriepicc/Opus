// FINAL COMPREHENSIVE CODEDGEN TEST
// Comprehensive test covering all edge cases

function int div_exact(int a, int b) { return a / b }
function int mod_exact(int a, int b) { return a % b }
function int add_exact(int a, int b) { return a + b }
function int sub_exact(int a, int b) { return a - b }
function int mul_exact(int a, int b) { return a * b }

function int is_lt_zero(int x) { if x < 0 { return 1 } return 0 }
function int is_lt_neg1(int x) { if x < -1 { return 1 } return 0 }

function int main() {
    // Division edge cases
    let d1 = div_exact(-2147483648, 1)
    let d2 = div_exact(-2147483648, -1)
    let d3 = div_exact(-2147483648, 2)
    let d4 = div_exact(100, 3)

    // Modulo edge cases
    let m1 = mod_exact(-2147483648, 1)
    let m2 = mod_exact(-2147483648, -1)
    let m3 = mod_exact(-2147483648, 2)
    let m4 = mod_exact(100, 3)

    // Arithmetic
    let a1 = add_exact(2147483647, 1)
    let a2 = sub_exact(-2147483648, 1)
    let a3 = mul_exact(12345678, 9)

    // Bitwise
    let b1 = -1 & 0x7FFFFFFF
    let b2 = 0xAAAAAAAA ^ 0x55555555
    let b3 = 1 << 31
    let b4 = -2147483648 >> 16

    // Comparisons
    let c1 = is_lt_zero(-2147483648)
    let c2 = is_lt_neg1(-2147483648)
    let c3 = is_lt_zero(2147483647)

    // Results
    print_int(d1); print(" ")
    print_int(d2); print(" ")
    print_int(d3); print(" ")
    print_int(d4); print(" ")
    print_int(m1); print(" ")
    print_int(m2); print(" ")
    print_int(m3); print(" ")
    print_int(m4); print(" ")
    print_int(a1); print(" ")
    print_int(a2); print(" ")
    print_int(a3); print(" ")
    print_int(b1); print(" ")
    print_int(b2); print(" ")
    print_int(b3); print(" ")
    print_int(b4); print(" ")
    print_int(c1); print(" ")
    print_int(c2); print(" ")
    print_int(c3); print("\n")

    return 0
}