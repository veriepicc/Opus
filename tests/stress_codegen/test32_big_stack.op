// TEST: very large stack frame allocation
// Try to allocate > 2GB stack to see if sub_imm handles it

function int big_stack_test() {
    // Allocate 20 local variables of 8 bytes each = 160 bytes
    // This is well within limits, but tests stack allocation
    var a0: int = 0
    var a1: int = 0
    var a2: int = 0
    var a3: int = 0
    var a4: int = 0
    var a5: int = 0
    var a6: int = 0
    var a7: int = 0
    var a8: int = 0
    var a9: int = 0
    var a10: int = 0
    var a11: int = 0
    var a12: int = 0
    var a13: int = 0
    var a14: int = 0
    var a15: int = 0
    var a16: int = 0
    var a17: int = 0
    var a18: int = 0
    var a19: int = 0

    a0 = 1; a1 = 2; a2 = 3; a3 = 4; a4 = 5
    a5 = 6; a6 = 7; a7 = 8; a8 = 9; a9 = 10
    a10 = 11; a11 = 12; a12 = 13; a13 = 14; a14 = 15
    a15 = 16; a16 = 17; a17 = 18; a18 = 19; a19 = 20

    return a0 + a1 + a2 + a3 + a4 + a5 + a6 + a7 + a8 + a9 + a10 + a11 + a12 + a13 + a14 + a15 + a16 + a17 + a18 + a19
}

function int main() {
    print_int(big_stack_test())
    print("\n")
    return 0
}