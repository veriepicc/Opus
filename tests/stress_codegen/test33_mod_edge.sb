// TEST: modulo with edge cases

function int main() {
    // INT_MIN % 1 = 0
    // INT_MIN % -1 = 0
    // These should always be 0 for any divisor
    let a = -2147483648 % 1
    let b = -2147483648 % -1
    let c = -2147483648 % 2
    let d = -2147483648 % 3

    print_int(a); print(" ")
    print_int(b); print(" ")
    print_int(c); print(" ")
    print_int(d); print("\n")
    return 0
}