// TEST 18: negative int cast to ptr then passed to C
// signed to unsigned conversion

using FnPtr = fn(ptr) -> int

function int main() {
    alloc_console()

    let kernel = get_module("kernel32.dll")
    let tick_fn = get_proc(kernel, "GetTickCount")
    let typed_fn = tick_fn as FnPtr

    // Negative int as pointer
    let neg = -1 as int
    let ptr_val = neg as ptr

    print("negative as ptr: ")
    print_hex(ptr_val)
    print("\n")

    // This will read from 0xFFFFFFFF which is invalid
    let result = typed_fn(ptr_val)
    return 0
}