using FnFive = fn(int, int, int, int, int) -> int

function int main() {
    let kernel = get_module("kernel32.dll")
    if kernel == 0 {
        return 1
    }

    let direct = get_proc(kernel, "GetCurrentThreadId")
    if direct == 0 {
        return 2
    }

    let typed = direct as FnFive
    let first = typed(1, 2, 3, 4, 5)
    let second = (get_proc(kernel, "GetCurrentThreadId") as FnFive)(6, 7, 8, 9, 10)

    if first == 0 || second == 0 {
        return 3
    }
    return 0
}
