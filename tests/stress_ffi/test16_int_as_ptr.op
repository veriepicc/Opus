// TEST 16: int where ptr expected - wrong register class
// RCX is for pointers, but opus might put int in RCX literally

using FnPtr = fn(ptr) -> ptr

function int main() {
    alloc_console()

    let kernel = get_module("kernel32.dll")
    let my_fn = get_proc(kernel, "GetTickCount")
    let typed_fn = my_fn as FnPtr

    // Pass integer as pointer - puts value in RCX literally
    let result = typed_fn(0xDEADBEEF as ptr)

    print("int as ptr result: ")
    print_hex(result)
    print("\n")
    return 0
}