using FnReturnsFn = fn(ptr, str) -> ptr
using FnCalled = fn() -> int

function int main() {
    let kernel = get_module("kernel32.dll")
    let my_fn = get_proc(kernel, "GetProcAddress")
    if kernel == 0 || my_fn == 0 {
        return 1
    }
    let get_fn = my_fn as FnReturnsFn
    let actual_fn = get_fn(kernel as ptr, "GetCurrentProcessId")
    if actual_fn == 0 {
        return 2
    }
    let typed_fn = actual_fn as FnCalled
    let result = typed_fn()
    if result != get_current_process_id() {
        return 3
    }
    print("double indirect ok\n")
    return 0
}
