// TEST 8: pass float arg but type says int
// coerce mismatch might corrupt register allocation

using FnFloatAsInt = fn(float) -> int

function int main() {
    alloc_console()

    let kernel = get_module("kernel32.dll")
    let my_fn = get_proc(kernel, "GetTickCount")
    let typed_fn = my_fn as FnFloatAsInt

    // pass a float literal but type expects int
    let val = typed_fn(3.14159)

    print("float->int result: ")
    print_int(val)
    print("\n")
    return 0
}