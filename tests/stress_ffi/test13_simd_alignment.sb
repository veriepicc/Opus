// TEST 13: alignment issues with SIMD types
// passing double/float where alignment matters

using FnDouble = fn(double) -> double

function int main() {
    alloc_console()

    let kernel = get_module("kernel32.dll")
    let my_fn = get_proc(kernel, "GetTickCount")
    let typed_fn = my_fn as FnDouble

    // double should go in XMM0 not RCX
    let result = typed_fn(3.14159265358979)

    print("double test result: ")
    print_int(result)
    print("\n")
    return 0
}