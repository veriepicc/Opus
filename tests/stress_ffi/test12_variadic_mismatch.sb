// TEST 12: variadic function with wrong arg types
// FFI to MessageBoxA is variadic

using FnMsgBox = fn(ptr, ptr, ptr, int) -> int

function int main() {
    alloc_console()

    let user32 = load_library("user32.dll")
    let box_fn = get_proc(user32, "MessageBoxA")
    let typed_fn = box_fn as FnMsgBox

    // Call with swapped args - type mismatch
    let result = typed_fn("title", "message", 0, 0)

    return 0
}