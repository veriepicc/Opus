// TEST 14: cast ptr to int then back
// losing pointer bits on x64

using FnInt = fn() -> int

function int main() {
    alloc_console()

    let kernel = get_module("kernel32.dll")
    let base = get_proc(kernel, "GetTickCount")

    // Cast to int (32-bit) then back to ptr
    // This truncates the pointer on x64!
    let as_int = base as int
    let back_to_ptr = as_int as ptr

    print("ptr->int->ptr:\n")
    print("original: ")
    print_hex(base)
    print("\n")
    print("as int: ")
    print_hex(as_int)
    print("\n")
    print("back to ptr: ")
    print_hex(back_to_ptr)
    print("\n")

    // Now call through corrupted pointer - HEAP CORRUPTION
    let fn_type = back_to_ptr as FnInt
    // let val = fn_type()  // uncomment for crash

    return 0
}