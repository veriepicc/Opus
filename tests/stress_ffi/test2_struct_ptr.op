// TEST 2: pass struct by value when C expects pointer
// opus might try to pass large struct on stack vs just pointer

struct BigStruct {
    a: int
    b: int
    c: int
    d: int
}

using FnPtrStruct = fn(ptr) -> int

function int main() {
    let kernel = get_module("kernel32.dll")

    let my_fn = get_proc(kernel, "GetTickCount64")
    let typed_fn = my_fn as FnPtrStruct

    let s = BigStruct { a: 1, b: 2, c: 3, d: 4 }

    // should pass pointer but might try to pass by value
    let val = typed_fn(s as ptr)
    print("result: ")
    print_int(val)
    print("\n")
    return 0
}