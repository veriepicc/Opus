function int main() {
    let n = 40000000;
    let mut a = malloc(n * 8) as *int;
    let mut out = malloc(n * 8) as *int;

    parallel for i in range(0, n) { a[i] = i; }

    parallel for i in range(0, n) {
        out[i] = (a[i] & 1) * 3 + a[i] * 5;
    }

    let mid = n / 2;
    let check = out[mid] & 255;
    free(a);
    free(out);
    return check;
}
