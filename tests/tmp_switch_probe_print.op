function int score(int state) {
    switch state {
    case 0:
        return 1
    case 1:
        return 2
    else:
        return 3
    }
}

function int main() {
    print_int(score(0))
    print(" ")
    print_int(score(1))
    print(" ")
    print_int(score(2))
    print("\n")
    return 0
}
