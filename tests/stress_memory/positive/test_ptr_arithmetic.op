import mem

function int main() {
    let block = mem.make_zero(64)
    
    let v1 = block as ptr
    let v2 = v1 + 32
    let v3 = v2 + 32
    
    mem.write(v1, 1)
    mem.write(v2, 2)
    mem.write(v3, 3)
    
    let x = mem.read(v1)
    let y = mem.read(v2)
    let z = mem.read(v3)
    
    free(block)
    return x + y + z
}