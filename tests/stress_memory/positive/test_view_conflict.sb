import mem

view V1 {
    a: int @ 0
    b: int @ 8
}

view V2 {
    c: int @ 4
    d: int @ 16
}

function int main() {
    let block = malloc(4)
    let v1 = block as V1
    v1.a = 0x1111
    v1.b = 0x2222
    
    let v2 = block as V2
    v2.c = 0x3333
    v2.d = 0x4444
    
    free(block)
    return 0
}