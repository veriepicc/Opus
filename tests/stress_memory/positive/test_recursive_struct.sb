import mem

struct Recursive {
    value: int
    children: ptr
}

function int main() {
    let root = mem.make_zero(24)
    let child = mem.make_zero(24)
    let grandchild = mem.make_zero(24)
    
    mem.write(root, 1)
    mem.write(root + 8, child)
    mem.write(root + 16, 2)
    
    mem.write(child, 2)
    mem.write(child + 8, grandchild)
    mem.write(child + 16, 2)
    
    mem.write(grandchild, 3)
    mem.write(grandchild + 8, 0)
    mem.write(grandchild + 16, 1)
    
    free(root)
    free(child)
    free(grandchild)
    
    return 0
}