import mem

struct Inner {
    value: int
}

struct Outer {
    inner: Inner
}

function int main() {
    let ptr = mem.make_zero(8)
    let outer = ptr as Outer
    let initialized = Inner { value: 42 }
    outer.inner = initialized
    let inner = outer.inner
    let val = inner.value
    free(ptr)
    if val != 42 {
        return 1
    }
    print("nested struct ok\n")
    return 0
}
