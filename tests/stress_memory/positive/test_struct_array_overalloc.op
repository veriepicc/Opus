import mem

struct S {
    a: int
    b: int
    c: int
}

function int main() {
    let base = mem.make_zero(48)
    
    let s1 = base as S
    let s2 = (base + 16) as S
    let s3 = (base + 32) as S
    
    s1.a = 1
    s1.b = 2
    s1.c = 3
    
    s2.a = 4
    s2.b = 5
    s2.c = 6
    
    s3.a = 7
    s3.b = 8
    s3.c = 9
    
    free(base)
    return 0
}