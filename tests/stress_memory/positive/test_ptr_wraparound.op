import mem

view HugeOffset {
    x: int @ 2147483647
}

function int main() {
    let block = mem.make_zero(8)
    let v = block as HugeOffset
    v.x = 123
    let unchanged = mem.read(block)
    free(block)
    if unchanged != 0 {
        return 1
    }
    print("out of bounds write recovered\n")
    return 0
}
