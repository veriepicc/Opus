import mem

view MaliciousView {
    a: int @ 0
    b: int @ 8
    c: int @ 16
    d: int @ 24
    e: int @ 32
}

function int main() {
    let tiny = malloc(8)
    let evil = tiny as MaliciousView
    evil.a = 1
    evil.b = 2
    evil.c = 3
    evil.d = 4
    evil.e = 5
    free(tiny)
    return evil.a + evil.b + evil.c + evil.d + evil.e
}