import mem

struct LargeStruct {
    a: int
    b: int
    c: int
    d: int
    e: int
    f: int
    g: int
    h: int
}

function int main() {
    let size: int = 2
    let ptr = malloc(size)
    let s = ptr as LargeStruct
    s.a = 1
    s.b = 2
    s.c = 3
    s.d = 4
    s.e = 5
    s.f = 6
    s.g = 7
    s.h = 8
    free(ptr)
    return s.a + s.b + s.c + s.d + s.e + s.f + s.g + s.h
}