import mem

function int main() {
    let block = mem.make_zero(64)
    let arr = block as ptr
    
    var i = 0
    loop {
        if i >= 16 {
            break
        }
        let pos = arr + (i * 8)
        mem_write(pos, i)
        i = i + 1
    }
    
    i = 0
    loop {
        if i >= 16 {
            break
        }
        let pos = arr + (i * 8)
        let val = mem_read(pos)
        if val != i {
            free(block)
            return 1
        }
        i = i + 1
    }
    
    free(block)
    return 0
}