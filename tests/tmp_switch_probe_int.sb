function int score(int state) {
    switch state {
    case 0:
        return 1
    case 1:
        return 2
    else:
        return 3
    }
}

function int main() {
    if score(0) != 1 {
        return 1
    }
    if score(1) != 2 {
        return 2
    }
    if score(2) != 3 {
        return 3
    }
    return 0
}
