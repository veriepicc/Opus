import mem

enum RuntimeOffset {
    Target = 0,
    Hits = 8,
    Ready = 12,
}

constant marker_offset: int = 16

view RuntimeState {
    target: ptr @ RuntimeOffset.Target
    hits: int @ RuntimeOffset.Hits
    ready: bool @ RuntimeOffset.Ready
    marker: long @ marker_offset
}

function int main() {
    let block = mem.make_zero(24)
    let rt = block as RuntimeState

    rt.target = block
    rt.hits = 42
    rt.ready = true
    rt.marker = 0x1122334455667788

    if rt.target != block {
        free(block)
        return 1
    }
    if rt.hits != 42 {
        free(block)
        return 2
    }
    if rt.ready != true {
        free(block)
        return 3
    }
    if mem.read32(block + 8) != 42 {
        free(block)
        return 4
    }
    if mem.read8(block + 12) != 1 {
        free(block)
        return 5
    }
    if rt.marker != 0x1122334455667788 {
        free(block)
        return 6
    }

    print_int(rt.hits)
    print_int(mem.read8(block + 12))
    free(block)
    return 0
}
